# Copy to .env.local and fill in. Do NOT commit real secrets.

# ── Private — server-side only ────────────────────────────────────────────────
# Read through lib/env.js by route handlers, server actions and server
# components. Never referenced from a client component, so the backend URL is
# not shipped to the browser. Both are REQUIRED: lib/env.js throws at build
# time if either is missing, rather than silently falling back to a placeholder
# domain and sending it Authorization headers.
#
# Include the version segment, e.g. https://api.example.com/api/v1
API_URL=
ADMIN_API_URL=

# Optional. If set, server-side product/material fetches send it as a Bearer
# token. Leave blank when the catalogue endpoints are public.
API_KEY=

# ── Public — inlined into the client bundle at build time ─────────────────────
# Anything with a NEXT_PUBLIC_ prefix is visible to every visitor. Never put a
# backend URL, key, or secret here.

# Public gate — "true" reveals the real site, anything else shows UnderConstruction.
#   Prod:    leave UNSET (or "false") until launch, then set to "true".
#   Staging: set to "true" so the team can review the real site.
#   Local:   set to "true" to develop against the real site.
# NOTE: NEXT_PUBLIC_ vars are baked in at build time, so a rebuild/redeploy
# is required for a change to take effect.
NEXT_PUBLIC_SITE_LIVE=
